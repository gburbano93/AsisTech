<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8FCFC"
    android:padding="8dp">

    <!-- Contenido superior -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Encabezado -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Empleados"
                    android:textColor="#172554"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Gestiona la información de tu equipo"
                    android:textColor="#64748B"
                    android:textSize="12sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/logo"
                android:contentDescription="Logo AsisTech"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- Buscador y botones -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/edtBuscarEmpleado"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hint="Buscar por nombre, cargo o área..."
                android:textSize="11sp"
                android:singleLine="true"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnActualizar"
                android:layout_width="75dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="Actualizar"
                android:textSize="10sp"
                android:textColor="#172554"
                android:backgroundTint="#FFFFFF" />

            <Button
                android:id="@+id/btnAgregarEmpleado"
                android:layout_width="105dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="+ Agregar"
                android:textSize="10sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#0F766E" />

        </LinearLayout>

        <!-- Total de empleados -->
        <TextView
            android:id="@+id/txtTotalEmpleados"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Total de empleados: 0"
            android:textColor="#172554"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Indicación de desplazamiento -->
        <TextView
            android:id="@+id/txtIndicacionLista"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Desliza hacia abajo para ver todos los empleados ↓"
            android:textColor="#64748B"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Lista: ocupa todo el espacio restante -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerListaEmpleados"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:clipToPadding="false"
        android:paddingBottom="100dp"
        android:scrollbars="vertical" />

</LinearLayout>
