<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FCFC"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aprobar horas extra"
                    android:textColor="#172554"
                    android:textSize="23sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Revisa y aprueba las solicitudes de horas extra"
                    android:textColor="#64748B"
                    android:textSize="11sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/logo"
                android:contentDescription="Logo AsisTech"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- BUSCADOR Y FILTRO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/edtBuscarHorasExtra"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:hint="Buscar por nombre, cargo o fecha..."
                android:textSize="10sp"
                android:singleLine="true"
                android:inputType="text"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <Button
                android:id="@+id/btnFiltrarHorasExtra"
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:layout_marginStart="7dp"
                android:text="Filtrar"
                android:textColor="#172554"
                android:textSize="10sp"
                android:backgroundTint="#FFFFFF" />

        </LinearLayout>

        <!-- TOTAL DE SOLICITUDES -->
        <TextView
            android:id="@+id/txtTotalHorasExtra"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Total de solicitudes: 0"
            android:textColor="#172554"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- LISTADO DINÁMICO -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerHorasExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:nestedScrollingEnabled="false" />

        <!-- MENSAJE CUANDO NO HAY SOLICITUDES -->
        <TextView
            android:id="@+id/txtSinHorasExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:gravity="center"
            android:text="No hay solicitudes pendientes"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
