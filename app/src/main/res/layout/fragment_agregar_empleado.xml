<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FCFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Encabezado con regreso -->
        <LinearLayout
            android:id="@+id/btnRegresarAgregarEmpleado"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#172554"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Agregar empleado"
                android:textColor="#172554"
                android:textSize="24sp"
                android:textStyle="bold" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Información del empleado"
            android:textColor="#0F766E"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Nombre -->
        <EditText
            android:id="@+id/edtNombreNuevoEmpleado"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:hint="Nombre completo"
            android:inputType="textPersonName"
            android:padding="12dp" />

        <!-- Correo -->
        <EditText
            android:id="@+id/edtCorreoNuevoEmpleado"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="12dp"
            android:hint="Correo electrónico"
            android:inputType="textEmailAddress"
            android:singleLine="true" />

        <TextView
            android:id="@+id/txtErrorCorreo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Ingresa un correo electrónico válido"
            android:textColor="#DC2626"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Contraseña -->
        <EditText
            android:id="@+id/edtContrasenaNuevoEmpleado"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Contraseña"
            android:inputType="textPassword"
            android:padding="12dp" />

        <!-- Área -->
        <EditText
            android:id="@+id/edtAreaNuevoEmpleado"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Área"
            android:inputType="text"
            android:padding="12dp" />

        <!-- Cargo -->
        <EditText
            android:id="@+id/edtCargoNuevoEmpleado"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Cargo"
            android:inputType="text"
            android:padding="12dp" />

        <!-- Fecha de ingreso -->
        <EditText
            android:id="@+id/edtFechaIngresoNuevoEmpleado"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:hint="Fecha de ingreso"
            android:inputType="date"
            android:padding="12dp" />

        <!-- Guardar -->
        <Button
            android:id="@+id/btnGuardarNuevoEmpleado"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="25dp"
            android:text="Guardar empleado"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:backgroundTint="#0F766E" />

    </LinearLayout>

</ScrollView>