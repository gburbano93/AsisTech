<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_2"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="20dp"
        android:paddingBottom="20dp">

        <!-- ENCABEZADO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- REGRESAR -->
            <TextView
                android:id="@+id/btnRegresarPerfil"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#0B315D"
                android:textSize="38sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mi perfil"
                    android:textColor="#0B315D"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Consulta tu información personal y laboral"
                    android:textColor="#64748B"
                    android:textSize="10sp" />

            </LinearLayout>

            <ImageView
                android:layout_width="58dp"
                android:layout_height="58dp"
                android:src="@drawable/logo"
                android:contentDescription="Logo AsisTech"
                android:scaleType="fitCenter" />

        </LinearLayout>

        <!-- TARJETA PRINCIPAL DEL PERFIL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="115dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="10dp">

            <!-- FOTO -->
            <ImageView
                android:id="@+id/imgFotoPerfil"
                android:layout_width="78dp"
                android:layout_height="78dp"
                android:src="@drawable/logo"
                android:contentDescription="Foto de perfil"
                android:scaleType="centerCrop" />

            <!-- DATOS -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txtNombrePerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="María Fernanda López"
                    android:textColor="#0B2A55"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtRolPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="#CCFBF1"
                    android:paddingStart="7dp"
                    android:paddingEnd="7dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="Empleado"
                    android:textColor="#047857"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/txtCargoPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="Auxiliar administrativa"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtAreaPerfil"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="Área: Administrativa"
                    android:textColor="#64748B"
                    android:textSize="8sp" />

            </LinearLayout>

            <!-- MARCA -->
            <LinearLayout
                android:layout_width="90dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:src="@drawable/logo"
                    android:contentDescription="AsisTech"
                    android:scaleType="fitCenter" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AsisTech"
                    android:textColor="#0B2A55"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tu tiempo,"
                    android:textColor="#64748B"
                    android:textSize="7sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="nuestro compromiso"
                    android:textColor="#64748B"
                    android:textSize="7sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- INFORMACIÓN PERSONAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="👤   Información personal"
                android:textColor="#0B2A55"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- DOCUMENTO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textColor="#0B315D"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Documento de identidad"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtDocumentoPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="1.075.234.567"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- CORREO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="✉"
                    android:textColor="#0B315D"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Correo electrónico"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtCorreoPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="maria.lopez@asistech.com"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- TELEFONO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="☎"
                    android:textColor="#0B315D"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Teléfono"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtTelefonoPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="320 456 7890"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- FECHA NACIMIENTO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textColor="#0B315D"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fecha de nacimiento"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtFechaNacimientoPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="14 de marzo de 1992"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- DIRECCION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="⌂"
                    android:textColor="#0B315D"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Dirección"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtDireccionPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="Carrera 12 # 45-78&#10;Nataga, Huila"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- INFORMACIÓN LABORAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💼   Información laboral"
                android:textColor="#0B2A55"
                android:textSize="13sp"
                android:textStyle="bold" />

            <!-- EMPRESA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textColor="#0B315D"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Empresa"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtEmpresaPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="AsisTech S.A.S."
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- TIPO PERFIL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="♟"
                    android:textColor="#0B315D"
                    android:textSize="16sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tipo de perfil"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtTipoPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="Empleado"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- CARGO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textColor="#0B315D"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Cargo"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtCargoLaboralPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="Auxiliar administrativa"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- AREA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="▥"
                    android:textColor="#0B315D"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Área"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtAreaLaboralPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="Administrativa"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- FECHA INGRESO -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="▣"
                    android:textColor="#0B315D"
                    android:textSize="15sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Fecha de ingreso"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtFechaIngresoPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="10 de enero de 2024"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

            <!-- JORNADA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="45dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="◷"
                    android:textColor="#0B315D"
                    android:textSize="17sp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Jornada laboral"
                    android:textColor="#64748B"
                    android:textSize="9sp" />

                <TextView
                    android:id="@+id/txtJornadaPerfil"
                    android:layout_width="155dp"
                    android:layout_height="wrap_content"
                    android:text="Lunes a viernes&#10;7:00 a.m. – 4:00 p.m."
                    android:textColor="#64748B"
                    android:textSize="9sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>