<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="72dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="8dp"
    android:paddingEnd="8dp"
    android:background="#FFFFFF">

    <!-- Foto -->
    <ImageView
        android:id="@+id/imgEmpleado"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:src="@drawable/logo"
        android:scaleType="centerCrop"
        android:contentDescription="Foto del empleado" />

    <!-- Nombre -->
    <TextView
        android:id="@+id/txtNombreEmpleado"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="Juan Carlos Pérez"
        android:textColor="#172554"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Área -->
    <TextView
        android:id="@+id/txtAreaCargo"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:text="Operaciones"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <!-- Cargo -->
    <TextView
        android:id="@+id/txtCargoEmpleado"
        android:layout_width="115dp"
        android:layout_height="wrap_content"
        android:text="Técnico operativo"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <!-- Estado -->
    <TextView
        android:id="@+id/txtEstadoEmpleado"
        android:layout_width="75dp"
        android:layout_height="32dp"
        android:gravity="center"
        android:background="#DDF7EF"
        android:text="Activo"
        android:textColor="#047857"
        android:textSize="10sp"
        android:textStyle="bold" />

</LinearLayout>