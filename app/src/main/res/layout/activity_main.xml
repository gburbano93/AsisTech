<?xml version="1.0" encoding="utf-8"?>

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Contenido principal -->
    <FrameLayout
        android:id="@+id/content_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Menú inferior fijo -->
    <LinearLayout
        android:id="@+id/bottom_menu"
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:layout_gravity="bottom"
        android:background="#FFFFFF"
        android:elevation="15dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <!-- Inicio -->
        <LinearLayout
            android:id="@+id/menuInicio"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:background="#0F766E">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="16dp"
                android:contentDescription="Inicio"
                android:src="@drawable/ic_inicio" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Inicio"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Empleados -->
        <LinearLayout
            android:id="@+id/menuEmpleados"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_menu_empleados"
                android:contentDescription="Empleados" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Empleados"
                android:textColor="#172554"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Reportes -->
        <LinearLayout
            android:id="@+id/menuReportes"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_menu_reportes"
                android:contentDescription="Reportes" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reportes"
                android:textColor="#172554"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Aprobar horas extra -->
        <LinearLayout
            android:id="@+id/menuHorasExtra"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_menu_horas_extra"
                android:contentDescription="Aprobar horas extra" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Horas extra"
                android:textColor="#172554"
                android:textSize="10sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Menú lateral -->
    <FrameLayout
        android:id="@+id/menu_container"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:elevation="20dp" />

    <!-- Panel de perfil -->
    <FrameLayout
        android:id="@+id/perfil_container"
        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F8FCFC"
        android:elevation="30dp"
        android:visibility="gone" />

</FrameLayout>