<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="46dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingEnd="6dp"
    android:background="#FFFFFF">

    <ImageView
        android:id="@+id/imgEmpleadoReporte"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:src="@drawable/ic_empleados"
        android:scaleType="centerCrop"
        android:contentDescription="Foto del empleado" />

    <TextView
        android:id="@+id/txtNombreReporte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.3"
        android:layout_marginStart="8dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#172554"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/txtAreaReporte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.8"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#64748B"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/txtCargoReporte"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="0.9"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="#64748B"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/txtHorasReporte"
        android:layout_width="55dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:maxLines="1"
        android:text="—"
        android:textColor="#172554"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="20dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="›"
        android:textColor="#172554"
        android:textSize="22sp" />

</LinearLayout>